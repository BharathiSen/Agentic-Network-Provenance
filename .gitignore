# .gitignore
# =============================================================================
# Files that must never be committed: build artefacts, caches, and secrets.
# Rule of thumb -- if a tool regenerates it, or it is machine-specific, or it
# holds a credential, it belongs here.
#
# SYNTAX WARNING: git does NOT support trailing comments. Writing
#     __pycache__/   # bytecode cache
# makes the whole line a literal pattern (including the spaces and the #), which
# silently matches nothing. Comments must sit on their own line, as below.
#
# NOTE: uv.lock is deliberately NOT ignored -- it is committed so CI and every
# developer resolve to identical dependency versions.
# =============================================================================

# The virtualenv uv builds from pyproject.toml. Recreate it with `uv sync`.
.venv/

# CPython bytecode: cache directories and stray individual files.
__pycache__/
*.pyc

# Test- and lint-runner caches (pytest's last-failed memory, ruff's incremental cache).
.pytest_cache/
.ruff_cache/

# npm packages for the Phase 7 TypeScript verifier (services/verifier-ts).
node_modules/

# Local secrets and connection strings. NEVER commit this.
.env

# Stray SQLite files from local experiments.
*.db
